DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DB_ECHO=false
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]
PGVECTOR_DIMENSIONS=384
APP_SECRET_KEY=change-me
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
APP_NAME=Agentic-RAG-KnowXAI
APP_ENV=development
DEBUG=false
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1
GEMINI_API_KEY=your-gemini-api-key # Optional if LLM_PROVIDER=local
GEMINI_MODEL=gemini-2.0-flash
GEMINI_OPENROUTER_MODEL=google/gemini-2.0-flash-001
NVIDIA_API_KEY=your-nvidia-or-openrouter-api-key # Optional if LLM_PROVIDER=local
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CHROMA_PERSIST_DIRECTORY=data/chroma

# ==============================================================================
# Biometric Authentication & Face Login Configuration
# ==============================================================================
# 256-bit AES-GCM encryption secret (minimum 16 characters, 32+ recommended)
BIOMETRIC_ENCRYPTION_KEY=your-secure-biometric-encryption-key-here-min-32-chars
# Provisional 1-to-1 Cosine similarity matching threshold (0.0 to 1.0, default: 0.75)
FACE_SIMILARITY_THRESHOLD=0.75

# ==============================================================================
# Google OAuth 2.0 / OIDC Configuration
# ==============================================================================
# Google Cloud Console Web OAuth Client ID (e.g. xxxxx.apps.googleusercontent.com)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
